PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smart_travel

# Comma-separated allowed origins. Use * for local development.
CORS_ORIGINS=*

# Optional SHMAAS/mock metro arrival upstream configuration.
SHMAAS_HOST=http://127.0.0.1:8787
SHMAAS_MERCHANT_ID=mock-merchant
SHMAAS_SALT=mock-salt
SHMAAS_CITY_CODE=mock-shanghai

# Optional Qwen-compatible AI route planning configuration.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen-max
