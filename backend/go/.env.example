PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=smart_travel_dev
DB_NAME=smart_travel

# Comma-separated allowed origins. Use * for local development.
CORS_ORIGINS=*

# Optional SHMAAS/mock metro arrival upstream configuration.
SHMAAS_HOST=http://127.0.0.1:8787
SHMAAS_MERCHANT_ID=mock-merchant
SHMAAS_SALT=mock-salt
SHMAAS_CITY_CODE=mock-shanghai

# Local MinIO public endpoint used in API responses.
# Android emulator reaches the host machine through 10.0.2.2.
OBJECT_STORAGE_PUBLIC_URL=http://10.0.2.2:9000
OBJECT_STORAGE_BUCKET=station-media

# Optional Qwen-compatible AI route planning configuration.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen-max
