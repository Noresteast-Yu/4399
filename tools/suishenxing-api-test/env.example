# 随申行会通过邮件提供请求域名、merchantId 和 salt。
# 不要把真实 .env 提交到仓库，也不要在聊天里粘贴真实密钥。
SHMAAS_HOST=https://your-shmaas-host.example.com
SHMAAS_MERCHANT_ID=your-merchant-id
SHMAAS_SALT=your-salt

# 上海 cityCode 需要以随申行实际开放平台数据为准。
SHMAAS_CITY_CODE=

# 可选：默认查询位置。下面只是字段示例，不代表推荐使用的真实站点参数。
SHMAAS_DEFAULT_LAT=
SHMAAS_DEFAULT_CLILON=
SHMAAS_DEFAULT_RADIUS=3000
